# --- Build ---
ZMK_IMAGE="zmkfirmware/zmk-build-arm:3.5"   # matches zmk revision in config/west.yml (v0.3 -> 3.5)
ZMK_BOARD="seeeduino_xiao_ble"              # XIAO nRF52840 (ZMK v0.3 board name)

# --- Flash ---
FLASH_TIMEOUT="30"  # seconds per discovery attempt
HOST_SIDE="r"  # central half: l or r; must match firmware roles
# Populated automatically by `just register right` / `just register left`.
UF2_RIGHT_SERIAL=""
UF2_LEFT_SERIAL=""

