#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/ext_power.h>

#define L0 0  // BASE
#define L1 1  // SYM
#define L2 2  // NUM
#define L3 3  // CYR
#define L4 4  // ADJ
#define L5 5  // SYS

/ {
    behaviors {
        hrm: home_row_mod {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <180>;
            quick-tap-ms = <0>;
            bindings = <&kp>, <&kp>;
            display-name = "Home Row Mod";
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        adjust_layer {
            if-layers = <L1 L2>;
            then-layer = <L3>;
        };
    };

    combos {
        compatible = "zmk,combos";

        // U + I = Escape (positions 5 and 6)
        combo_ui_esc {
            timeout-ms = <50>;
            key-positions = <5 6>;
            bindings = <&kp ESC>;
        };

        //// F + J = Caps Lock (positions 12 and 15)
        //combo_fj_caps {
        //    timeout-ms = <50>;
        //    key-positions = <12 15>;
        //    bindings = <&kp CAPS>;
        //};

        // L + P = Quote / Apostrophe (positions 17 and 18)
        combo_lp_quote {
            timeout-ms = <50>;
            key-positions = <17 18>;
            bindings = <&kp SQT>;
        };

        // L-NUM + L-CYR thumbs = L5 Admin / Sys Layer (positions 31 and 35)
        combo_num_cyr_sys {
            timeout-ms = <100>;
            key-positions = <31 35>;
            bindings = <&mo L5>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

// ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

// ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
        base_layer {
            display-name = "BASE";
// ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
//                                                 ┏━━━━━━━━━┳━━━━━━━━━┳━━━━━━━━━┳━━━━━━━━━┓                      ┏━━━━━━━━━┳━━━━━━━━━┳━━━━━━━━━┳━━━━━━━━━┓
//                                                 ┃    W    ┃    E    ┃    R    ┃    T    ┃ ╭───────╮  ╭───────╮ ┃    Y    ┃    U    ┃    I    ┃    O    ┃
//                             ┏━━━━━━━━━┳━━━━━━━━━╋━━━━━━━━━╋━━━━━━━━━╋━━━━━━━━━╋━━━━━━━━━┫ │ -     │  │ -     │ ┣━━━━━━━━━╋━━━━━━━━━╋━━━━━━━━━╋━━━━━━━━━╋━━━━━━━━━┳━━━━━━━━━┓
//                             ┃    Q    ┃  ⌃ / A  ┃  ⌥ / S  ┃  ⌘ / D  ┃  ⇧ / F  ┃    G    ┃ │BRIGHT │  │  VOL  │ ┃    H    ┃  ⇧ / J  ┃  ⌘ / K  ┃  ⌥ / L  ┃  ⌃ / P  ┃    ⌫    ┃
//                             ┗━━━━━━━━━╋━━━━━━━━━╋━━━━━━━━━╋━━━━━━━━━╋━━━━━━━━━╋━━━━━━━━━┫ │     + │  │     + │ ┣━━━━━━━━━╋━━━━━━━━━╋━━━━━━━━━╋━━━━━━━━━╋━━━━━━━━━╋━━━━━━━━━┛
//                                       ┃    Z    ┃    X    ┃    C    ┃    V    ┃    B    ┃ ╰───────╯  ╰───────╯ ┃    N    ┃    M    ┃    ,    ┃    .    ┃    /    ┃
//                                       ┗━━━━━━━━━┻━━━━━━━━━┻━━━━━━━━━╋━━━━━━━━━╋━━━━━━━━━╋━━━━━━━━━┓  ┏━━━━━━━━━╋━━━━━━━━━╋━━━━━━━━━╋━━━━━━━━━┻━━━━━━━━━┻━━━━━━━━━┛
//                                                                     ┃    ↹    ┃ <L-SYM> ┃    ↵    ┃  ┃    ␣    ┃ <L-NUM> ┃ <L-CYR> ┃
//                                                                     ┗━━━━━━━━━┻━━━━━━━━━┻━━━━━━━━━┛  ┗━━━━━━━━━┻━━━━━━━━━┻━━━━━━━━━┛

            bindings = <
//                             ┏━━━━━━━━━━━━━┳━━━━━━━━━━━━━┳━━━━━━━━━━━━━┳━━━━━━━━━━━━━┓                              ┏━━━━━━━━━━━━━┳━━━━━━━━━━━━━┳━━━━━━━━━━━━━┳━━━━━━━━━━━━━┓
                                    &kp W         &kp E         &kp R         &kp T                                        &kp Y         &kp U         &kp I         &kp O
// ┏━━━━━━━━━━━━━┳━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━┫                              ┣━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━┳━━━━━━━━━━━━━┓
        &kp Q     &hrm LCTRL A   &hrm LALT S   &hrm LGUI D   &hrm LSHFT F     &kp G                                        &kp H     &hrm RSHFT J   &hrm RGUI K   &hrm RALT L  &hrm RCTRL P     &kp BSPC
// ┗━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━┫                              ┣━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━┛
                      &kp Z         &kp X         &kp C         &kp V         &kp B                                        &kp N         &kp M       &kp COMMA      &kp DOT       &kp FSLH
//               ┗━━━━━━━━━━━━━┻━━━━━━━━━━━━━┻━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━┓  ┏━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━┻━━━━━━━━━━━━━┻━━━━━━━━━━━━━┛
                                                               &kp TAB        &mo L2      &kp ENTER        &kp SPACE      &mo L1         &sl L4
//                                                         ┗━━━━━━━━━━━━━┻━━━━━━━━━━━━━┻━━━━━━━━━━━━━┛  ┗━━━━━━━━━━━━━┻━━━━━━━━━━━━━┻━━━━━━━━━━━━━┛
            >;

            sensor-bindings = <&inc_dec_kp C_BRI_UP C_BRI_DN &inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

// ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

// ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
        sym_layer {
            display-name = "SYM";
// ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
//                                                 ┏━━━━━━━━━┳━━━━━━━━━┳━━━━━━━━━┳━━━━━━━━━┓                      ┏━━━━━━━━━┳━━━━━━━━━┳━━━━━━━━━┳━━━━━━━━━┓
//                                                 ┃         ┃         ┃    @    ┃         ┃ ╭───────╮  ╭───────╮ ┃    [    ┃    {    ┃    }    ┃    ]    ┃
//                             ┏━━━━━━━━━┳━━━━━━━━━╋━━━━━━━━━╋━━━━━━━━━╋━━━━━━━━━╋━━━━━━━━━┫ │ -     │  │ -     │ ┣━━━━━━━━━╋━━━━━━━━━╋━━━━━━━━━╋━━━━━━━━━╋━━━━━━━━━┳━━━━━━━━━┓
//                             ┃    ~    ┃    ⌃    ┃    ⌥    ┃    ⌘    ┃    ⇧    ┃         ┃ │F15/F14│  │F14/F15│ ┃    ←    ┃    ↓    ┃    ↑    ┃    →    ┃    '    ┃    ⌦    ┃
//                             ┗━━━━━━━━━╋━━━━━━━━━╋━━━━━━━━━╋━━━━━━━━━╋━━━━━━━━━╋━━━━━━━━━┫ │     + │  │     + │ ┣━━━━━━━━━╋━━━━━━━━━╋━━━━━━━━━╋━━━━━━━━━╋━━━━━━━━━╋━━━━━━━━━┛
//                                       ┃         ┃         ┃    /    ┃    #    ┃         ┃ ╰───────╯  ╰───────╯ ┃    =    ┃    (    ┃    )    ┃    *    ┃    &    ┃
//                                       ┗━━━━━━━━━┻━━━━━━━━━┻━━━━━━━━━╋━━━━━━━━━╋━━━━━━━━━╋━━━━━━━━━┓  ┏━━━━━━━━━╋━━━━━━━━━╋━━━━━━━━━╋━━━━━━━━━┻━━━━━━━━━┻━━━━━━━━━┛
//                                                                     ┃    ↹    ┃ <L-SYM> ┃    ↵    ┃  ┃    ␣    ┃ <L-NUM> ┃ <L-CYR> ┃
//                                                                     ┗━━━━━━━━━┻━━━━━━━━━┻━━━━━━━━━┛  ┗━━━━━━━━━┻━━━━━━━━━┻━━━━━━━━━┛
//                                                                                                                     ↑
            bindings = <
//                             ┏━━━━━━━━━━━━━┳━━━━━━━━━━━━━┳━━━━━━━━━━━━━┳━━━━━━━━━━━━━┓                              ┏━━━━━━━━━━━━━┳━━━━━━━━━━━━━┳━━━━━━━━━━━━━┳━━━━━━━━━━━━━┓
                                    &none         &none         &kp AT        &none                                       &kp LBKT      &kp LBRC      &kp RBRC      &kp RBKT
// ┏━━━━━━━━━━━━━┳━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━┫                              ┣━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━┳━━━━━━━━━━━━━┓
      &kp TILDE     &kp LCTRL      &kp LALT      &kp LGUI     &kp LSHFT       &none                                       &kp LEFT      &kp DOWN       &kp UP      &kp RIGHT      &kp SQT       &kp DEL
// ┗━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━┫                              ┣━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━┛
                      &none         &none      &kp KP_SLASH    &kp HASH       &none                                     &kp KP_EQUAL    &kp LPAR      &kp RPAR  &kp KP_MULTIPLY   &kp AMPS
//               ┗━━━━━━━━━━━━━┻━━━━━━━━━━━━━┻━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━┓  ┏━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━┻━━━━━━━━━━━━━┻━━━━━━━━━━━━━┛
                                                                &trans        &trans        &trans           &trans       &trans        &trans
//                                                         ┗━━━━━━━━━━━━━┻━━━━━━━━━━━━━┻━━━━━━━━━━━━━┛  ┗━━━━━━━━━━━━━┻━━━━━━━━━━━━━┻━━━━━━━━━━━━━┛
            >;

            sensor-bindings = <&inc_dec_kp F15 F14 &inc_dec_kp F14 F15>;
        };

