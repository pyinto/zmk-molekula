        adj_layer {
            display-name = "ADJ";

            bindings = <
//                             ┏━━━━━━━━━━━━━┳━━━━━━━━━━━━━┳━━━━━━━━━━━━━┳━━━━━━━━━━━━━┓                              ┏━━━━━━━━━━━━━┳━━━━━━━━━━━━━┳━━━━━━━━━━━━━┳━━━━━━━━━━━━━┓
                                 &kp C_PREV      &kp C_PP     &kp C_NEXT   &kp C_MUTE                                     &kp F12        &kp F7        &kp F8        &kp F9
// ┏━━━━━━━━━━━━━┳━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━┫                              ┣━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━┳━━━━━━━━━━━━━┓
        &none       &kp LCTRL      &kp LALT      &kp LGUI     &kp LSHFT       &none                                       &kp F11        &kp F4        &kp F5        &kp F6        &none         &none
// ┗━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━┫                              ┣━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━┛
                      &none         &none         &none         &none         &none                                       &kp F10        &kp F1        &kp F2        &kp F3        &none
