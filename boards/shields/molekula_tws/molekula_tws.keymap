//                             ┏━━━━━━━━━┳━━━━━━━━━╋━━━━━━━━━╋━━━━━━━━━╋━━━━━━━━━╋━━━━━━━━━┫ │ -     │  │ -     │ ┣━━━━━━━━━╋━━━━━━━━━╋━━━━━━━━━╋━━━━━━━━━╋━━━━━━━━━┳━━━━━━━━━┓
//                             ┃   BOOT  ┃  RESET  ┃  BT CLR ┃         ┃         ┃         ┃ │BRIGHT │  │  VOL  │ ┃  EP TOG ┃         ┃         ┃         ┃         ┃         ┃
//                             ┗━━━━━━━━━╋━━━━━━━━━╋━━━━━━━━━╋━━━━━━━━━╋━━━━━━━━━╋━━━━━━━━━┫ │     + │  │     + │ ┣━━━━━━━━━╋━━━━━━━━━╋━━━━━━━━━╋━━━━━━━━━╋━━━━━━━━━╋━━━━━━━━━┛
//                                       ┃         ┃         ┃         ┃         ┃         ┃ ╰───────╯  ╰───────╯ ┃  BT 1   ┃  BT 2   ┃   BT 3  ┃   BT 4  ┃   BT 5  ┃
//                                       ┗━━━━━━━━━┻━━━━━━━━━┻━━━━━━━━━╋━━━━━━━━━╋━━━━━━━━━╋━━━━━━━━━┓  ┏━━━━━━━━━╋━━━━━━━━━╋━━━━━━━━━╋━━━━━━━━━┻━━━━━━━━━┻━━━━━━━━━┛
//                                                                     ┃    ↹    ┃ <L-SYM> ┃    ↵    ┃  ┃    ␣    ┃ <L-NUM> ┃ <L-CYR> ┃
