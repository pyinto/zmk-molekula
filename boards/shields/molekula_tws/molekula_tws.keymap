// Activate: Hold left-to-right thumb position 31 (mo NUM).
// Encoders: L inc=F18, dec=F13; R inc=F19, dec=F20.

        num_layer {
            display-name = "NUM";

            bindings = <
//                             ┏━━━━━━━━━━━━━┳━━━━━━━━━━━━━┳━━━━━━━━━━━━━┳━━━━━━━━━━━━━┓                              ┏━━━━━━━━━━━━━┳━━━━━━━━━━━━━┳━━━━━━━━━━━━━┳━━━━━━━━━━━━━┓
                                  &kp EQUAL     &kp MINUS      &kp PLUS       &none                                        &none         &kp N7        &kp N8        &kp N9
