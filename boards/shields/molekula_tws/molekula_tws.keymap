//                             ┏━━━━━━━━━┳━━━━━━━━━╋━━━━━━━━━╋━━━━━━━━━╋━━━━━━━━━╋━━━━━━━━━┫ │ -     │  │ -     │ ┣━━━━━━━━━╋━━━━━━━━━╋━━━━━━━━━╋━━━━━━━━━╋━━━━━━━━━┳━━━━━━━━━┓
//                             ┃         ┃    ⌃    ┃    ⌥    ┃    ⌘    ┃    ⇧    ┃         ┃ │BRIGHT │  │  VOL  │ ┃   F12   ┃   F4    ┃   F5    ┃   F6    ┃   F10   ┃         ┃
//                             ┗━━━━━━━━━╋━━━━━━━━━╋━━━━━━━━━╋━━━━━━━━━╋━━━━━━━━━╋━━━━━━━━━┫ │     + │  │     + │ ┣━━━━━━━━━╋━━━━━━━━━╋━━━━━━━━━╋━━━━━━━━━╋━━━━━━━━━╋━━━━━━━━━┛
//                                       ┃         ┃         ┃         ┃         ┃         ┃ ╰───────╯  ╰───────╯ ┃   F11   ┃   F1    ┃   F2    ┃   F3    ┃         ┃
//                                       ┗━━━━━━━━━┻━━━━━━━━━┻━━━━━━━━━╋━━━━━━━━━╋━━━━━━━━━╋━━━━━━━━━┓  ┏━━━━━━━━━╋━━━━━━━━━╋━━━━━━━━━╋━━━━━━━━━┻━━━━━━━━━┻━━━━━━━━━┛
//                                                                     ┃    ↹    ┃ <L-SYM> ┃    ↵    ┃  ┃    ␣    ┃ <L-NUM> ┃ <L-CYR> ┃
//                                                                     ┗━━━━━━━━━┻━━━━━━━━━┻━━━━━━━━━┛  ┗━━━━━━━━━┻━━━━━━━━━┻━━━━━━━━━┛
//                                                                                    ↑                                ↑

            bindings = <
//                             ┏━━━━━━━━━━━━━┳━━━━━━━━━━━━━┳━━━━━━━━━━━━━┳━━━━━━━━━━━━━┓                              ┏━━━━━━━━━━━━━┳━━━━━━━━━━━━━┳━━━━━━━━━━━━━┳━━━━━━━━━━━━━┓
                                 &kp C_PREV      &kp C_PP     &kp C_NEXT   &kp C_MUTE                                     &kp F13        &kp F7        &kp F8        &kp F9
// ┏━━━━━━━━━━━━━┳━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━┫                              ┣━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━┳━━━━━━━━━━━━━┓
        &none       &kp LCTRL      &kp LALT      &kp LGUI     &kp LSHFT       &none                                       &kp F12        &kp F4        &kp F5        &kp F6       &kp F10        &none
// ┗━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━┫                              ┣━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━┛
                      &none         &none         &none         &none         &none                                       &kp F11        &kp F1        &kp F2        &kp F3        &none
//               ┗━━━━━━━━━━━━━┻━━━━━━━━━━━━━┻━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━┓  ┏━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━┻━━━━━━━━━━━━━┻━━━━━━━━━━━━━┛
                                                                &trans        &trans        &trans           &trans        &trans        &trans
//                                                         ┗━━━━━━━━━━━━━┻━━━━━━━━━━━━━┻━━━━━━━━━━━━━┛  ┗━━━━━━━━━━━━━┻━━━━━━━━━━━━━┻━━━━━━━━━━━━━┛
            >;

            sensor-bindings = <&inc_dec_kp C_BRI_UP C_BRI_DN &inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

