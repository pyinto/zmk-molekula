#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/ext_power.h>


#define L_BASE 0
#define L_SYM  1
#define L_NUM  2
#define L_ADJ  3
#define L_CYR  4
#define L_SYS  5

/ {
    behaviors {
        hrm: home_row_mod {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <180>;
            quick-tap-ms = <0>;
            bindings = <&kp>, <&kp>;
            display-name = "Home Row Mod";
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        adjust_layer {
            if-layers = <L_SYM L_NUM>;
            then-layer = <L_ADJ>;
        };
    };

    combos {
        compatible = "zmk,combos";

        // U + I = Escape (positions 5 and 6)
        combo_ui_esc {
            timeout-ms = <50>;
            key-positions = <5 6>;
            bindings = <&kp ESC>;
        };

        //// F + J = Caps Lock (positions 12 and 15)
        //combo_fj_caps {
        //    timeout-ms = <50>;
        //    key-positions = <12 15>;
        //    bindings = <&kp CAPS>;
        //};

        // L + P = Quote / Apostrophe (positions 17 and 18)
        combo_lp_quote {
            timeout-ms = <50>;
            key-positions = <17 18>;
            bindings = <&kp SQT>;
        };

        // L_NUM + L_CYR thumbs = L_SYS Admin / Sys Layer (positions 31 and 35)
        combo_num_cyr_sys {
            timeout-ms = <300>;
            key-positions = <31 35>;
            bindings = <&mo L_SYS>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

// Diagram legend: — = disabled (&none); ▽ = transparent (&trans), resolved on lower active layers.
// mo = momentary layer; sl = sticky layer; home-row modifier/key = hold modifier / tap key.
// Thumb positions are zero-based and run left-to-right: [30 31 32] [33 34 35].

// ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

// ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
// BASE
// ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
//                                                 ┏━━━━━━━━━┳━━━━━━━━━┳━━━━━━━━━┳━━━━━━━━━┓                      ┏━━━━━━━━━┳━━━━━━━━━┳━━━━━━━━━┳━━━━━━━━━┓
//                                                 ┃    W    ┃    E    ┃    R    ┃    T    ┃ ╭───────╮  ╭───────╮ ┃    Y    ┃    U    ┃    I    ┃    O    ┃
//                             ┏━━━━━━━━━┳━━━━━━━━━╋━━━━━━━━━╋━━━━━━━━━╋━━━━━━━━━╋━━━━━━━━━┫ │  INC  │  │  INC  │ ┣━━━━━━━━━╋━━━━━━━━━╋━━━━━━━━━╋━━━━━━━━━╋━━━━━━━━━┳━━━━━━━━━┓
//                             ┃    Q    ┃   ⌃/A   ┃   ⌥/S   ┃   ⌘/D   ┃   ⇧/F   ┃    G    ┃ │ ENC L │  │ ENC R │ ┃    H    ┃   ⇧/J   ┃   ⌘/K   ┃   ⌥/L   ┃   ⌃/P   ┃    ⌫    ┃
//                             ┗━━━━━━━━━╋━━━━━━━━━╋━━━━━━━━━╋━━━━━━━━━╋━━━━━━━━━╋━━━━━━━━━┫ │  DEC  │  │  DEC  │ ┣━━━━━━━━━╋━━━━━━━━━╋━━━━━━━━━╋━━━━━━━━━╋━━━━━━━━━╋━━━━━━━━━┛
//                                       ┃    Z    ┃    X    ┃    C    ┃    V    ┃    B    ┃ ╰───────╯  ╰───────╯ ┃    N    ┃    M    ┃    ,    ┃    .    ┃    /    ┃
//                                       ┗━━━━━━━━━┻━━━━━━━━━┻━━━━━━━━━╋━━━━━━━━━╋━━━━━━━━━╋━━━━━━━━━┓  ┏━━━━━━━━━╋━━━━━━━━━╋━━━━━━━━━╋━━━━━━━━━┻━━━━━━━━━┻━━━━━━━━━┛
//                                                                     ┃   Tab   ┃  mo NUM ┃  Enter  ┃  ┃  Space  ┃  mo SYM ┃  sl CYR ┃
//                                                                     ┗━━━━━━━━━┻━━━━━━━━━┻━━━━━━━━━┛  ┗━━━━━━━━━┻━━━━━━━━━┻━━━━━━━━━┛
// Activate: Default layer.
// Encoders: L inc=C_BRI_UP, dec=C_BRI_DN; R inc=C_VOL_DN, dec=C_VOL_UP.

        base_layer {
            display-name = "BASE";

            bindings = <
//                             ┏━━━━━━━━━━━━━┳━━━━━━━━━━━━━┳━━━━━━━━━━━━━┳━━━━━━━━━━━━━┓                              ┏━━━━━━━━━━━━━┳━━━━━━━━━━━━━┳━━━━━━━━━━━━━┳━━━━━━━━━━━━━┓
                                    &kp W         &kp E         &kp R         &kp T                                        &kp Y         &kp U         &kp I         &kp O
// ┏━━━━━━━━━━━━━┳━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━┫                              ┣━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━┳━━━━━━━━━━━━━┓
        &kp Q     &hrm LCTRL A   &hrm LALT S   &hrm LGUI D   &hrm LSHFT F     &kp G                                        &kp H     &hrm RSHFT J   &hrm RGUI K   &hrm RALT L  &hrm RCTRL P     &kp BSPC
// ┗━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━┫                              ┣━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━┛
                      &kp Z         &kp X         &kp C         &kp V         &kp B                                        &kp N         &kp M       &kp COMMA      &kp DOT       &kp FSLH
//               ┗━━━━━━━━━━━━━┻━━━━━━━━━━━━━┻━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━┓  ┏━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━┻━━━━━━━━━━━━━┻━━━━━━━━━━━━━┛
                                                               &kp TAB        &mo L_NUM   &kp ENTER        &kp SPACE      &mo L_SYM      &sl L_CYR
//                                                         ┗━━━━━━━━━━━━━┻━━━━━━━━━━━━━┻━━━━━━━━━━━━━┛  ┗━━━━━━━━━━━━━┻━━━━━━━━━━━━━┻━━━━━━━━━━━━━┛
            >;

            sensor-bindings = <&inc_dec_kp C_BRI_UP C_BRI_DN &inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

// ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

// ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
// SYM
// ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
//                                                 ┏━━━━━━━━━┳━━━━━━━━━┳━━━━━━━━━┳━━━━━━━━━┓                      ┏━━━━━━━━━┳━━━━━━━━━┳━━━━━━━━━┳━━━━━━━━━┓
//                                                 ┃    —    ┃    —    ┃    @    ┃    —    ┃ ╭───────╮  ╭───────╮ ┃    [    ┃    {    ┃    }    ┃    ]    ┃
//                             ┏━━━━━━━━━┳━━━━━━━━━╋━━━━━━━━━╋━━━━━━━━━╋━━━━━━━━━╋━━━━━━━━━┫ │  INC  │  │  INC  │ ┣━━━━━━━━━╋━━━━━━━━━╋━━━━━━━━━╋━━━━━━━━━╋━━━━━━━━━┳━━━━━━━━━┓
//                             ┃    ~    ┃  L Ctrl ┃  L Alt  ┃  L GUI  ┃ L Shift ┃    —    ┃ │ ENC L │  │ ENC R │ ┃    ←    ┃    ↓    ┃    ↑    ┃    →    ┃    '    ┃   Del   ┃
//                             ┗━━━━━━━━━╋━━━━━━━━━╋━━━━━━━━━╋━━━━━━━━━╋━━━━━━━━━╋━━━━━━━━━┫ │  DEC  │  │  DEC  │ ┣━━━━━━━━━╋━━━━━━━━━╋━━━━━━━━━╋━━━━━━━━━╋━━━━━━━━━╋━━━━━━━━━┛
//                                       ┃    —    ┃    —    ┃    —    ┃    #    ┃    —    ┃ ╰───────╯  ╰───────╯ ┃    <    ┃    (    ┃    )    ┃    >    ┃    &    ┃
//                                       ┗━━━━━━━━━┻━━━━━━━━━┻━━━━━━━━━╋━━━━━━━━━╋━━━━━━━━━╋━━━━━━━━━┓  ┏━━━━━━━━━╋━━━━━━━━━╋━━━━━━━━━╋━━━━━━━━━┻━━━━━━━━━┻━━━━━━━━━┛
//                                                                     ┃    ▽    ┃    ▽    ┃    ▽    ┃  ┃    ▽    ┃    ▽    ┃    ▽    ┃
//                                                                     ┗━━━━━━━━━┻━━━━━━━━━┻━━━━━━━━━┛  ┗━━━━━━━━━┻━━━━━━━━━┻━━━━━━━━━┛
// Activate: Hold left-to-right thumb position 34 (mo SYM).
// Encoders: L inc=F17, dec=F16; R inc=F14, dec=F15.

        sym_layer {
            display-name = "SYM";

            bindings = <
//                             ┏━━━━━━━━━━━━━┳━━━━━━━━━━━━━┳━━━━━━━━━━━━━┳━━━━━━━━━━━━━┓                              ┏━━━━━━━━━━━━━┳━━━━━━━━━━━━━┳━━━━━━━━━━━━━┳━━━━━━━━━━━━━┓
                                    &none         &none         &kp AT        &none                                       &kp LBKT      &kp LBRC      &kp RBRC      &kp RBKT
// ┏━━━━━━━━━━━━━┳━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━┫                              ┣━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━┳━━━━━━━━━━━━━┓
      &kp TILDE     &kp LCTRL      &kp LALT      &kp LGUI     &kp LSHFT       &none                                       &kp LEFT      &kp DOWN       &kp UP      &kp RIGHT      &kp SQT       &kp DEL
// ┗━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━┫                              ┣━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━┛
                      &none         &none         &none        &kp HASH       &none                                        &kp LT       &kp LPAR     &kp RPAR        &kp GT       &kp AMPS
//               ┗━━━━━━━━━━━━━┻━━━━━━━━━━━━━┻━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━┓  ┏━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━┻━━━━━━━━━━━━━┻━━━━━━━━━━━━━┛
                                                                &trans        &trans        &trans           &trans       &trans        &trans
//                                                         ┗━━━━━━━━━━━━━┻━━━━━━━━━━━━━┻━━━━━━━━━━━━━┛  ┗━━━━━━━━━━━━━┻━━━━━━━━━━━━━┻━━━━━━━━━━━━━┛
            >;

            sensor-bindings = <&inc_dec_kp F17 F16 &inc_dec_kp F14 F15>;
        };

