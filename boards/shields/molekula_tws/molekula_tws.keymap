//                             ┃    —    ┃  L Ctrl ┃  L Alt  ┃  L GUI  ┃ L Shift ┃    —    ┃ │ ENC L │  │ ENC R │ ┃   F11   ┃    F4   ┃    F5   ┃    F6   ┃    —    ┃    —    ┃
//                             ┗━━━━━━━━━╋━━━━━━━━━╋━━━━━━━━━╋━━━━━━━━━╋━━━━━━━━━╋━━━━━━━━━┫ │  DEC  │  │  DEC  │ ┣━━━━━━━━━╋━━━━━━━━━╋━━━━━━━━━╋━━━━━━━━━╋━━━━━━━━━╋━━━━━━━━━┛
//                                       ┃    —    ┃    —    ┃    —    ┃    —    ┃    —    ┃ ╰───────╯  ╰───────╯ ┃   F10   ┃    F1   ┃    F2   ┃    F3   ┃    —    ┃
