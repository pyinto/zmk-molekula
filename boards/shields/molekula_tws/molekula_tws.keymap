      &kp UNDER     &kp LCTRL      &kp LALT      &kp LGUI     &kp LSHFT       &none                                        &none         &kp N4        &kp N5        &kp N6        &kp N0       &kp DEL
// ┗━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━┫                              ┣━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━┛
                    &kp CARET    &kp PERCENT    &kp DOLLAR   &kp ASTERISK     &none                                        &none         &kp N1        &kp N2        &kp N3       &kp PIPE
//               ┗━━━━━━━━━━━━━┻━━━━━━━━━━━━━┻━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━┓  ┏━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━╋━━━━━━━━━━━━━┻━━━━━━━━━━━━━┻━━━━━━━━━━━━━┛
                                                                &trans        &trans        &trans           &trans        &trans        &trans
